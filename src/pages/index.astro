---
import Base from '../layouts/Base.astro';
import '../styles/home.css';
---
<Base title="Airborne Dent Repair" description="" nav="Home" css="home">
<main><header class="hero" id="top">
  <div class="hero-panel">
    <p class="eyebrow rv">Gunter, Texas — Veteran Owned &amp; Operated</p>
    <h1 class="display h-xl rv rv-d1">Hail Doesn't Wait. Neither Do We.</h1>
    <p class="lede rv rv-d2">Paintless dent repair, windshield replacement, and window tint. Lifetime warranty on every repair.</p>
    <div class="cta-row rv rv-d3">
      <a class="btn btn-solid" href="#contact">Get a Free Estimate</a>
      <a class="btn btn-ghost" href="tel:6822260543">682-226-0543</a>
    </div>
  </div>
  <div class="hero-figure" role="img" aria-label="A Mercedes-Benz S-Class coupe under repair in the Airborne Dent Repair shop bay">
    <span class="slot-tag hero-slot-tag">Still stands in for [HERO-VIDEO]</span>
  </div>
</header>

<div class="marquee" aria-label="Airborne Dent Repair credentials">
  <div class="marquee-track">
    <ul><li>Veteran Owned &amp; Operated</li><li>Master ARC Certified</li><li>Lifetime PDR Warranty</li><li>Loaner Vehicles Available</li><li>We Work With Your Insurance</li></ul>
    <ul aria-hidden="true"><li>Veteran Owned &amp; Operated</li><li>Master ARC Certified</li><li>Lifetime PDR Warranty</li><li>Loaner Vehicles Available</li><li>We Work With Your Insurance</li></ul>
  </div>
</div>

<section id="services">
  <div class="wrap">
    <div class="sec-head rv">
      <p class="eyebrow">What We Do</p>
      <h2 class="display h-lg">Four Things. All Of Them Right.</h2>
    </div>
  </div>
  <div class="wrap">
    <div class="services">
      <a class="svc rv" href="#">
        <div class="shot" style="background-image:url(&quot;/img/card-hail-damage.jpg&quot;)" role="img" aria-label="Hail damage across a black Mercedes-Benz C-Class hood"></div>
        <div class="svc-body">
          <h3>Hail Damage<br>Repair</h3>
          <p>Storm damage removed without touching your factory paint.</p>
          <span class="go">View service <span>→</span></span>
        </div>
      </a>
      <a class="svc rv rv-d1" href="#">
        <div class="shot" style="background-image:url(&quot;/img/card-dent-ding.jpg&quot;)" role="img" aria-label="A reflection board reading a door panel during paintless dent repair"></div>
        <div class="svc-body">
          <h3>Dent &amp; Door<br>Ding Repair</h3>
          <p>Parking lot dings, creases, and dents — gone.</p>
          <span class="go">View service <span>→</span></span>
        </div>
      </a>
      <a class="svc rv rv-d2" href="#">
        <div class="slot"><span class="slot-tag">[SERVICE-03] Windshield — needs a real shot</span></div>
        <div class="svc-body">
          <h3>Windshield<br>Replacement</h3>
          <p>OEM-quality glass, mobile or in our shop — your call.</p>
          <span class="go">View service <span>→</span></span>
        </div>
      </a>
      <a class="svc rv rv-d3" href="#">
        <div class="shot" style="background-image:url(&quot;/img/card-window-tint.jpg&quot;)" role="img" aria-label="A tinted pickup in the shop bay"></div>
        <div class="svc-body">
          <h3>Window<br>Tint</h3>
          <p>XPEL film exclusively, with the manufacturer’s warranty behind it.</p>
          <span class="go">View service <span>→</span></span>
        </div>
      </a>
    </div>
  </div>
</section>

<section id="work">
  <div class="wrap">
    <div class="sec-head rv">
      <p class="eyebrow">Before &amp; After · Drag to compare</p>
      <h2 class="display h-lg">The Damage Was Real.<br>Now Find It.</h2>
    </div>
    <div class="ba-rail">
      <div class="ba-feature rv">
        <div class="ba" data-ba>
          <div class="ba-layer ba-before" style="background-image:url(&quot;/img/img-01601d4a77.jpeg&quot;)"><span class="ba-tag">Before</span></div>
          <div class="ba-layer ba-after" style="background-image:url(&quot;/img/img-ea3b4a7cf7.jpeg&quot;)"><span class="ba-tag">After</span></div>
          <div class="ba-handle"></div>
          <input class="ba-range" type="range" min="0" max="100" value="42" aria-label="Compare hail damage before and after repair on a Mercedes-Benz C-Class hood">
        </div>
        <div class="ba-cap"><span>Hail damage · C-Class hood, roof and fender</span><span>Paintless — original factory finish</span></div>
      </div>

      <div class="ba-half rv">
        <p class="eyebrow" style="margin-bottom:.7rem">Window Tint · XPEL</p>
        <div class="ba" data-ba>
          <div class="ba-layer ba-before" style="background-image:url(&quot;/img/img-d658fbaced.jpeg&quot;)"><span class="ba-tag">No tint</span></div>
          <div class="ba-layer ba-after" style="background-image:url(&quot;/img/img-f518ef14c1.jpeg&quot;)"><span class="ba-tag">Tinted</span></div>
          <div class="ba-handle"></div>
          <input class="ba-range" type="range" min="0" max="100" value="45" aria-label="Compare the same car with and without window tint">
        </div>
        <div class="ba-cap"><span>Same car, same light, same angle</span><span>XPEL film</span></div>
      </div>
    </div>
    <p class="prose rv" style="margin-top:1.75rem;font-size:.88rem">Two pairs live, both real. Every pair on this page has to be an actual job — see the note below.</p>
  </div>
</section>

<section id="work-gallery">
  <div class="wrap">
    <div class="sec-head rv">
      <p class="eyebrow">Through The Shop</p>
      <h2 class="display h-lg">What Comes<br>Through The Bay.</h2>
      <p class="prose">From a Rolls-Royce Dawn to a work truck. The standard doesn't move with the badge on the hood.</p>
    </div>
  </div>
  <div class="wrap">
    <div class="gallery">
      <figure class="gal rv" style="margin:0"><div class="shot" style="background-image:url(&quot;/img/gallery-rolls-royce-dawn.jpg&quot;)" role="img" aria-label="A white Rolls-Royce Dawn in the shop"></div><figcaption>Rolls-Royce Dawn</figcaption></figure>
      <figure class="gal rv rv-d1" style="margin:0"><div class="shot" style="background-image:url(&quot;/img/gallery-amg-g63-front.jpg&quot;)" role="img" aria-label="A black Mercedes-AMG G 63"></div><figcaption>Mercedes-AMG G 63</figcaption></figure>
      <figure class="gal rv rv-d2" style="margin:0"><div class="shot" style="background-image:url(&quot;/img/gallery-amg-gle63.jpg&quot;)" role="img" aria-label="A black Mercedes-AMG GLE 63"></div><figcaption>Mercedes-AMG GLE 63</figcaption></figure>
      <figure class="gal rv" style="margin:0"><div class="shot" style="background-image:url(&quot;/img/gallery-ram-trx.jpg&quot;)" role="img" aria-label="A matte grey Ram TRX"></div><figcaption>Ram TRX</figcaption></figure>
      <figure class="gal rv rv-d1" style="margin:0"><div class="shot" style="background-image:url(&quot;/img/gallery-vw-passat-REDACTED.jpg&quot;)" role="img" aria-label="A Volkswagen Passat hood read under shop lighting"></div><figcaption>Volkswagen Passat</figcaption></figure>
      <figure class="gal rv rv-d2" style="margin:0"><div class="shot" style="background-image:url(&quot;/img/gallery-amg-g63-rear-REDACTED.jpg&quot;)" role="img" aria-label="A black Mercedes-AMG G 63, rear three-quarter"></div><figcaption>Mercedes-AMG G 63</figcaption></figure>
    </div>
  </div>
</section>

<section id="fleet">
  <div class="wrap">
    <div class="fleet">
      <div class="slot rv"><span class="slot-tag">[MEDIA: FLEET-VIDEO] · slow pan or full 360° orbit</span></div>
      <div class="fleet-copy">
        <p class="eyebrow rv">The Loaner Fleet</p>
        <h2 class="display h-md rv rv-d1">You Shouldn't Have To Rearrange Your Life For A Repair.</h2>
        <p class="prose rv rv-d2">We keep a personal fleet of loaner vehicles on hand. Drop your car off, take a set of keys, and get on with your day.</p>
        <p class="rv rv-d3"><span class="chip">Confirm — which vehicles are loaners vs. customer cars?</span></p>
      </div>
    </div>
  </div>
</section>

<section style="padding-block:0">
  <div class="split">
    <a class="panel panel-retail" href="#contact">
      <p class="eyebrow">Retail</p>
      <h3>I Have Damage<br>On My Vehicle</h3>
      <p>Send a few photos and we'll tell you what you're looking at.</p>
      <span class="go">Get an estimate →</span>
    </a>
    <a class="panel panel-b2b" href="#wholesale" id="wholesale">
      <p class="eyebrow">Wholesale</p>
      <h3>I Manage A<br>Dealership Or Fleet</h3>
      <p>Up to 25 vehicles a week, with pickup and delivery on trade accounts.</p>
      <span class="go">Wholesale &amp; fleet →</span>
    </a>
  </div>
</section>

<section id="claims">
  <div class="wrap">
    <div class="sec-head rv">
      <p class="eyebrow">How It Works</p>
      <h2 class="display h-lg">Four Steps. That's It.</h2>
    </div>
  </div>
  <div class="wrap">
    <div class="steps">
      <div class="step rv"><p class="n">01</p><h3>Send Photos</h3><p>Text a few shots or stop by the shop on Reed Ln.</p></div>
      <div class="step rv rv-d1"><p class="n">02</p><h3>We Handle The Claim</h3><p>We document the damage, talk to your adjuster, and manage the file so you don't have to.</p></div>
      <div class="step rv rv-d2"><p class="n">03</p><h3>Take A Loaner</h3><p>Keys in hand the same day you drop off.</p></div>
      <div class="step rv rv-d3"><p class="n">04</p><h3>Pick It Up Finished</h3><p>Original factory paint, untouched.</p></div>
    </div>
  </div>
</section>

<section id="about">
  <div class="wrap">
    <div class="vet">
      <div class="slot rv"><span class="slot-tag">[MEDIA: OWNER-PORTRAIT] · in the shop, natural light</span></div>
      <div class="fleet-copy">
        <p class="eyebrow rv">Veteran Owned &amp; Operated</p>
        <h2 class="display h-lg rv rv-d1">Airborne Isn't<br>Just A Name.</h2>
        <p class="prose rv rv-d2">Our founder served as a U.S. Army paratrooper with 1st Battalion (Airborne), 501st Infantry Regiment — the Geronimos — out of Alaska. He came home and spent five years running high-volume hail operations that moved hundreds of vehicles a month, which is long enough to watch what happens to the work when volume is the only thing anyone measures.</p>
        <p class="prose rv rv-d3">Airborne Dent Repair was built to do it the other way around: fewer cars on the floor, more attention on each one. That isn't a slogan. It's the reason the shop exists.</p>
        <p class="rv rv-d3" style="margin-top:.4rem"><a class="btn btn-ghost" href="#about" style="font-size:clamp(.95rem,1.4vw,1.1rem);padding:.5rem 1.15rem">Read the full story</a></p>
      </div>
    </div>
  </div>
</section>

<section id="area">
  <div class="wrap">
    <div class="sec-head rv">
      <p class="eyebrow">Where We Work</p>
      <h2 class="display h-lg">Gunter Is Home Base.<br>The Work Isn't.</h2>
    </div>
    <div class="area">
      <div class="tiers">
        <div class="tier rv">
          <span class="tag">The Shop</span>
          <h3>Gunter, Texas</h3>
          <p>489 Reed Ln, Unit 2. Drop-off, loaner keys, and every service we offer under one roof.</p>
        </div>
        <div class="tier rv rv-d1">
          <span class="tag">Regular Service Area</span>
          <h3>Greater DFW &amp; North Texas</h3>
          <p>Routine repairs, mobile windshield service, and dealer accounts across the metroplex and North Texas.</p>
        </div>
        <div class="tier tier-cat rv rv-d2">
          <span class="tag">Catastrophe Response</span>
          <h3>Nationwide Deployment</h3>
          <p>When a severe hail event hits, we send catastrophe response teams to the affected area — anywhere in the country. Most shops wait for the storm to come to them.</p>
        </div>
      </div>
      <div class="slot rv">
        <div class="area-inner">
          <p class="pin">Gunter, TX</p>
          <span class="slot-tag" style="margin:0">Map — DFW &amp; North Texas shaded olive, CAT deployment markers in red</span>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="final" id="contact">
  <div class="wrap">
    <div class="final-grid">
      <div>
        <p class="eyebrow rv">Free Estimate · No Obligation</p>
        <h2 class="display h-lg rv rv-d1" style="margin-top:.6rem">Send Us The<br>Damage.</h2>
      </div>
      <div class="cta-row rv rv-d2">
        <a class="btn btn-solid" href="mailto:airbornepdr@gmail.com">Start an Estimate</a>
        <a class="btn btn-ghost" href="tel:6822260543">682-226-0543</a>
      </div>
    </div>
  </div>
</section></main>
</Base>
