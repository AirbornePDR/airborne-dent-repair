---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/fonts.css';

// forms: loads Web3Forms' client script, which only injects hCaptcha and sets their
// public sitekey — it does not touch form submission, which the inline script below
// handles. Set only on the two pages carrying a form, so every other page keeps
// making zero third-party requests.
interface Props { title: string; description: string; nav: string; css: string; forms?: boolean; }
const { title, description, nav, css, forms = false } = Astro.props;

// The live domain. Astro.site is set in astro.config.mjs and is the single source
// of truth — no fallback host here on purpose. If site is ever unset the build
// should fail loudly rather than quietly emitting canonicals for example.com.
const SITE = Astro.site;
if (!SITE) throw new Error('astro.config.mjs is missing `site` — canonical URLs and the sitemap depend on it.');
const canonical = new URL(Astro.url.pathname, SITE).href;

const BUSINESS = {
  "@context": "https://schema.org",
  "@type": "AutoBodyShop",
  name: "Airborne Dent Repair",
  url: SITE.href,
  description:
    "Veteran owned paintless dent and hail damage repair, windshield replacement and XPEL window tint in Gunter, Texas.",
  address: {
    "@type": "PostalAddress",
    streetAddress: "489 Reed Ln, Unit 2",
    addressLocality: "Gunter", addressRegion: "TX",
    postalCode: "75058", addressCountry: "US",
  },
  telephone: "+1-682-226-0543",
  faxNumber: "+1-833-907-5267",
  email: "airbornepdr@gmail.com",
  areaServed: ["Gunter TX", "Dallas–Fort Worth metroplex", "North Texas"],
  openingHoursSpecification: [{
    "@type": "OpeningHoursSpecification",
    dayOfWeek: ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"],
    opens: "09:00", closes: "19:00",
  }],
  makesOffer: ["Hail damage repair","Paintless dent repair","Windshield replacement","XPEL window tint"],
};
---
<!doctype html>
<html lang="en" data-css={css}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Airborne Dent Repair" />
  <meta property="og:locale" content="en_US" />
  <meta name="twitter:card" content="summary_large_image" />
  <!-- Self-hosted variable font. crossorigin is REQUIRED even though this is
       same-origin: fonts are always fetched in anonymous CORS mode, and without
       it the preload will not match the real request and the file downloads twice. -->
  <link rel="preload" href="/fonts/Archivo-var-latin.woff2" as="font" type="font/woff2" crossorigin />
  <script type="application/ld+json" set:html={JSON.stringify(BUSINESS)} />
</head>
<body>
  <Nav current={nav} />
  <slot />
  <Footer />
  {forms && <script is:inline async defer src="https://web3forms.com/client/script.js"></script>}
  <script>
    const nav = document.getElementById('nav');
    const onScroll = () => nav?.classList.toggle('stuck', window.scrollY > 24);
    onScroll(); addEventListener('scroll', onScroll, { passive: true });

    const yr = document.getElementById('yr');
    if (yr) yr.textContent = String(new Date().getFullYear());

    // Before/after sliders.
    //
    // The <input type="range"> stays, because it is what makes these operable by
    // keyboard and what a screen reader announces. But it is NOT what handles
    // pointer input any more. A range input is dragged by its thumb, and on iOS
    // Safari a touch that does not land on the thumb does nothing at all -- no
    // jump to the tap, no drag. Here the thumb is invisible and 56px wide inside
    // an image that is ~350px on a phone, so almost every touch missed it. That
    // is the reported "works on desktop, dead on mobile": a mouse gets a click on
    // the track turned into a jump, a finger does not.
    //
    // So the container takes the pointer input and writes the value back into the
    // range. One code path for mouse, touch and pen, and a touch anywhere on the
    // image works.
    document.querySelectorAll('[data-ba]').forEach((ba) => {
      const range = ba.querySelector('.ba-range');
      if (!range) return;
      const paint = () => ba.style.setProperty('--split', range.value + '%');
      range.addEventListener('input', paint);
      paint();

      // No PointerEvent means something very old; leave the native range in charge.
      if (!window.PointerEvent) return;
      ba.classList.add('ba-pointer');

      const setFromX = (clientX) => {
        const r = ba.getBoundingClientRect();
        if (!r.width) return;
        const pct = ((clientX - r.left) / r.width) * 100;
        range.value = Math.max(0, Math.min(100, pct));
        paint();
      };

      let id = null, startX = 0, dragging = false;

      ba.addEventListener('pointerdown', (e) => {
        if (e.button > 0) return;
        id = e.pointerId; startX = e.clientX; dragging = false;
        try { ba.setPointerCapture(id); } catch (err) {}
        // A mouse press has no competing gesture, so it can move the handle at
        // once. A finger might be starting a vertical scroll, so wait until the
        // drag is actually sideways before grabbing anything -- otherwise the
        // handle lurches every time someone scrolls past the photo.
        if (e.pointerType === 'mouse') { dragging = true; setFromX(e.clientX); }
      });

      ba.addEventListener('pointermove', (e) => {
        if (e.pointerId !== id) return;
        if (!dragging && Math.abs(e.clientX - startX) < 4) return;
        dragging = true;
        setFromX(e.clientX);
      });

      const release = (e) => {
        if (e.pointerId !== id) return;
        if (!dragging) setFromX(e.clientX); // a tap moves the handle to the tap
        try { ba.releasePointerCapture(id); } catch (err) {}
        id = null; dragging = false;
      };
      ba.addEventListener('pointerup', release);
      // fires when the browser takes the gesture for scrolling; leave the value alone
      ba.addEventListener('pointercancel', () => { id = null; dragging = false; });
    });

    // Autoplaying loops are motion too. CSS cannot stop a video that has
    // already started, so pause them here and let the poster stand in.
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.querySelectorAll('video[autoplay]').forEach((v) => {
        v.removeAttribute('autoplay');
        v.loop = false;
        v.pause();
      });
    }

    // ---- Web3Forms submit handling -------------------------------------------
    // Posts to Web3Forms and renders the outcome on this page. Never redirects to
    // a third-party confirmation screen, and never claims success optimistically:
    // the success state requires both an HTTP 200 and success:true in the body.
    document.querySelectorAll('form[data-w3f]').forEach((form) => {
      const result = document.getElementById(form.getAttribute('data-result'));
      const submit = form.querySelector('[type="submit"]');
      if (!result || !submit) return;
      const submitLabel = submit.textContent;
      const FALLBACK =
        ' Call <a href="tel:+16822260543">682-226-0543</a> or email ' +
        '<a href="mailto:' + form.getAttribute('data-fallback-email') + '">' +
        form.getAttribute('data-fallback-email') + '</a> and we will pick it up that way.';

      const errorFor = (el) => {
        const id = el.getAttribute('aria-describedby');
        return id ? document.getElementById(id) : null;
      };
      const clearError = (el) => {
        el.removeAttribute('aria-invalid');
        const e = errorFor(el); if (e) e.textContent = '';
      };
      const setError = (el, msg) => {
        el.setAttribute('aria-invalid', 'true');
        const e = errorFor(el); if (e) e.textContent = msg;
      };

      const checkField = (el) => {
        const v = (el.value || '').trim();
        if (el.hasAttribute('required') && !v) return 'This one is required.';
        // Deliberately not a regex. An earlier version was, and a lost backslash
        // turned [^\s@] into [^s@], which quietly rejected every address whose
        // local part began with "s". Plain string checks cannot fail that way.
        if (el.type === 'email' && v) {
          const at = v.indexOf('@');
          const dot = v.lastIndexOf('.');
          const spaced = /\s/.test(v);
          if (spaced || at < 1 || v.indexOf('@', at + 1) !== -1 || dot < at + 2 || dot > v.length - 3)
            return 'That email address does not look right.';
        }
        if (el.type === 'tel' && v && v.replace(/[^0-9]/g, '').length < 10)
          return 'A 10-digit phone number, please.';
        return '';
      };

      const fields = () => form.querySelectorAll('input[name]:not([type=checkbox]):not([type=radio]), select[name], textarea[name]');
      fields().forEach((el) => {
        el.addEventListener('blur', () => { const m = checkField(el); m ? setError(el, m) : clearError(el); });
        el.addEventListener('input', () => { if (el.getAttribute('aria-invalid')) clearError(el); });
      });

      const show = (kind, html) => {
        result.className = 'w3f-result ' + kind;
        result.innerHTML = html;
        result.hidden = false;
        result.focus();
      };

      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        let firstBad = null, count = 0;
        fields().forEach((el) => {
          const m = checkField(el);
          if (m) { setError(el, m); count++; if (!firstBad) firstBad = el; }
          else clearError(el);
        });
        if (count) {
          show('bad', '<p><strong>' + (count === 1 ? 'One field needs' : count + ' fields need') +
            ' attention.</strong> The form is marked up below &mdash; fix those and send again.</p>');
          if (firstBad) firstBad.focus();
          return;
        }

        // Only block on the captcha if it actually rendered. If hCaptcha was
        // blocked or failed to load there is no widget to complete, and refusing
        // to submit would strand the person with no way through — let it go and
        // report whatever Web3Forms says instead.
        const box = form.querySelector('.h-captcha');
        const rendered = box && box.querySelector('iframe');
        const token = form.querySelector('[name="h-captcha-response"]');
        if (rendered && !(token && token.value)) {
          show('bad', '<p><strong>One step left.</strong> Complete the anti-spam check just above ' +
            'the button, then send again.</p>');
          return;
        }

        // Duplicate keys (checkbox groups) collapse into one comma-joined value
        // rather than the last one silently winning.
        const payload = {};
        new FormData(form).forEach((value, key) => {
          payload[key] = key in payload ? payload[key] + ', ' + value : value;
        });

        submit.disabled = true;
        submit.textContent = 'Sending…';
        try {
          const res = await fetch('https://api.web3forms.com/submit', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify(payload),
          });
          let data = {};
          try { data = await res.json(); } catch (err) {}

          if (res.ok && data.success === true) {
            show('ok', '<p><strong>Sent.</strong> ' + form.getAttribute('data-success') + '</p>');
            form.reset();
            fields().forEach(clearError);
            if (window.hcaptcha && typeof window.hcaptcha.reset === 'function') {
              try { window.hcaptcha.reset(); } catch (err) {}
            }
            form.querySelectorAll('.w3f-after-send').forEach((el) => { el.hidden = true; });
          } else {
            const why = (data && data.message) ? String(data.message) : 'HTTP ' + res.status;
            show('bad', '<p><strong>That did not send.</strong> ' + why + '</p><p>' + FALLBACK + '</p>');
          }
        } catch (err) {
          show('bad', '<p><strong>That did not send.</strong> The connection failed, so nothing ' +
            'reached us.</p><p>' + FALLBACK + '</p>');
        } finally {
          submit.disabled = false;
          submit.textContent = submitLabel;
        }
      });
    });

    const els = document.querySelectorAll('.rv');
    if (!('IntersectionObserver' in window) ||
        matchMedia('(prefers-reduced-motion: reduce)').matches) {
      els.forEach((e) => e.classList.add('in'));
    } else {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((en) => {
          if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); }
        });
      }, { rootMargin: '0px 0px -8% 0px', threshold: 0.06 });
      els.forEach((e) => io.observe(e));
    }
  </script>
</body>
</html>
